						<details id="e-n-accordion-item-1357" class="e-n-accordion-item">
				<summary class="e-n-accordion-item-title" data-accordion-index="8" tabindex="-1" aria-expanded="false" aria-controls="e-n-accordion-item-1357">
					<span class="e-n-accordion-item-title-header"><div class="e-n-accordion-item-title-text"> 8. Bulleted, numbered, and lettered lists </div></span>
							<span class="e-n-accordion-item-title-icon">
			<span class="e-opened"><i aria-hidden="true" class="phl phlight-minus"></i></span>
			<span class="e-closed"><i aria-hidden="true" class="phl phlight-plus"></i></span>
